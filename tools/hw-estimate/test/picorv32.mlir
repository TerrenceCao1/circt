  hw.module @picorv32_regs(in %clk : i1, in %wen : i1, in %waddr : i6, in %raddr1 : i6, in %raddr2 : i6, in %wdata : i32, out rdata1 : i32, out rdata2 : i32) {
    %c-1_i5 = hw.constant -1 : i5
    %c-2_i5 = hw.constant -2 : i5
    %0 = comb.extract %waddr from 0 : (i6) -> i5
    %1 = comb.xor %0, %c-1_i5 : i5
    %2 = comb.sub %c-2_i5, %1 : i5
    %3 = hw.array_inject %regs[%2], %wdata : !hw.array<31xi32>, i5
    %4 = seq.to_clock %clk
