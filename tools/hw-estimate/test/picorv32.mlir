    %regs = seq.firreg %5 clock %4 : !hw.array<31xi32>
    %6 = comb.extract %raddr1 from 0 : (i6) -> i5
    %7 = comb.xor %6, %c-1_i5 : i5
    %8 = comb.sub %c-2_i5, %7 : i5
    %9 = hw.array_get %regs[%8] : !hw.array<31xi32>, i5
    %10 = comb.extract %raddr2 from 0 : (i6) -> i5
    %11 = comb.xor %10, %c-1_i5 : i5
    %12 = comb.sub %c-2_i5, %11 : i5
    %13 = hw.array_get %regs[%12] : !hw.array<31xi32>, i5
    hw.output %9, %13 : i32, i32
  }
